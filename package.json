{
  "name": "photo-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:py": "uv run --project services/thumbnails ruff check services/thumbnails && uv run --project services/thumbnails ruff format --check services/thumbnails",
    "test:py": "uv run --project services/thumbnails pytest services/thumbnails",
    "build:py": "services/thumbnails/build.sh",
    "test:infra": "set -e; node --test infra/modules/*/functions/*.test.mjs; for m in infra/modules/*/; do if [ -d \"$m/tests\" ]; then (cd \"$m\" && tofu init -input=false >/dev/null && tofu test); fi; done"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
